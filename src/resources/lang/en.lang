# Boss & victory
# ---------------------------------------------------------------------------
boss.taunt = Captain: "So the penguin shows his face. I've been waiting."
victory.cache = You haul the Captain's cache of stolen fish back to the village. (+100 Rep)
victory.captain = Captain defeated - the harbor is safe.

